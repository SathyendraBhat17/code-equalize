{
  "name": "code-equalize",
  "displayName": "code-equalize",
  "description": "Explains code errors and suggests fixes in your native language",
  "version": "0.0.1",
  "icon": "media/code-equalize-icon.png",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:code-equalize.explain",
    "onCommand:code-equalize.explainFromEditor",
    "onDebug",
    "onDebugResolve:java",
    "onDebugResolve:debugpy"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-equalize.explain",
        "title": "Explain in My Language",
        "category": "Code Equalize"
      },
      {
        "command": "code-equalize.explainFromEditor",
        "title": "Explain with Code Equalize"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "code-equalize.explainFromEditor",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "code-equalize.explainFromEditor",
          "when": "editorLangId == python || editorLangId == java || editorLangId == c || editorLangId == cpp",
          "group": "navigation@100"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test:unit": "npm run compile && node --test test/*.test.cjs",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.118.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
